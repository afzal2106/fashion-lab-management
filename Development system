<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Fashion Lab Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore-compat.js"></script>
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #0f172a; 
            background-image: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.85)), url('https://images.unsplash.com/photo-1555353540-64fd8bce231e?q=100&w=1920&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            -webkit-font-smoothing: antialiased; 
        }
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        .page { display: none !important; animation: fadeIn 0.3s ease-out; }
        .page.active { display: block !important; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        #toast-container { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 99999; display: flex; flex-direction: column; gap: 10px; pointer-events: none; width: 90%; max-width: 380px; }
        .toast-msg { background: #ffffff; color: #0f172a; padding: 16px 20px; border-radius: 12px; font-size: 13px; font-weight: 600; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); border: 1px solid #e2e8f0; border-left: 6px solid #4f46e5; animation: slideDownToast 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); display: flex; align-items: center; gap: 14px; }
        @keyframes slideDownToast { from { opacity: 0; transform: translateY(-20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
    </style>
</head>
<body class="text-slate-800 pb-24">

<div id="toast-container"></div>

<div id="page-main" class="page active w-full max-w-7xl mx-auto p-4 flex flex-col justify-center min-h-[95vh] relative">
    <div class="absolute top-4 left-4 md:top-8 md:left-8 z-10 text-left">
        <div class="bg-white/90 backdrop-blur-md border border-white/20 px-3 py-2 md:px-6 md:py-4 rounded-full shadow-lg flex items-center gap-2 md:gap-4 transition-all">
            <i class="fa-solid fa-clock text-indigo-600 text-[12px] md:text-2xl"></i>
            <div class="flex flex-col">
                <p id="realtime-clock" class="text-[12px] md:text-xl font-bold text-slate-800 font-mono leading-none">00:00:00</p>
                <p id="realtime-date" class="text-[8px] md:text-xs font-bold text-slate-500 uppercase tracking-widest leading-none mt-0.5 md:mt-1.5">Loading...</p>
            </div>
        </div>
    </div>

<div class="absolute top-4 right-4 md:top-8 md:right-8 z-10">
        <button onclick="toggleLang()" class="bg-white/90 backdrop-blur-md border border-white/20 px-3 py-2 md:px-6 md:py-4 rounded-full text-[10px] md:text-sm font-bold text-slate-800 shadow-lg flex items-center gap-2 md:gap-3 hover:bg-white transition active:scale-95">
            <i class="fa-solid fa-language text-indigo-600 text-sm md:text-xl"></i>
            <span id="lang-indicator">EN</span>
        </button>
    </div>

<div class="text-center mb-10 mt-20 md:mt-24">
        <div class="h-20 w-20 md:h-28 md:w-28 bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl mx-auto flex items-center justify-center shadow-[0_0_30px_rgba(0,0,0,0.5)] mb-5 transition-transform border border-slate-700">
            <i class="fa-solid fa-flask text-white text-3xl md:text-5xl"></i>
        </div>
        <h1 class="text-2xl md:text-4xl font-black text-white tracking-tight drop-shadow-lg">Fashion Lab</h1>
        <p class="text-xs md:text-sm text-indigo-300 font-bold mt-2 tracking-widest uppercase drop-shadow">Management System</p>
    </div>

<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-4 max-w-5xl mx-auto w-full" id="main-menu-grid">
        <button id="btn-lead" onclick="goToApp('lead')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-address-book"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Lead Database</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Manage contacts</p></div>
        </button>
        <button id="btn-finance" onclick="goToApp('kewangan')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-chart-pie"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Finance Record</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Sales & ROAS dashboard</p></div>
        </button>
        <button id="btn-accounting" onclick="goToApp('accounting')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-file-invoice"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Accounting</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Balance Sheet records</p></div>
        </button>
        <button id="btn-wallet" onclick="goToApp('wallet')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-wallet"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">J&T Wallet</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Manage prepaid & COD</p></div>
        </button>
        <button id="btn-bank" onclick="goToApp('bank')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-building-columns"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Bank Balance</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Company cash flow</p></div>
        </button>
        <button id="btn-order" onclick="goToApp('order')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-cart-shopping"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Order Details</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Sales & tracking records</p></div>
        </button>
        <button id="btn-mgmt" onclick="goToApp('management')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-list-check"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Order Mgmt</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Booking & Pending list</p></div>
        </button>
        <button id="btn-return" onclick="goToApp('return')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-truck-ramp-box"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Shipping Loss</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Return Order Expenses</p></div>
        </button>
        <button id="btn-supplier" onclick="goToApp('supplier')" class="main-menu-btn w-full md:col-span-2 bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-fuchsia-50 text-fuchsia-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Supplier Debt</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Debt & Floating Dashboard</p></div>
        </button>
        <button id="btn-users" onclick="goToApp('users')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-slate-800 text-white flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-users-gear"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">User Mgmt</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Access & Roles</p></div>
        </button>
        <button id="btn-approvals" onclick="goToApp('approvals')" class="main-menu-btn w-full bg-white/90 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-white/20 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-white hover:shadow-xl transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-clipboard-check"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-slate-800 leading-tight">Approvals</h2><p class="text-[10px] md:text-[11px] text-slate-500 font-medium mt-1 leading-tight">Delete Requests</p></div>
        </button>
        <button onclick="logKeluarUser()" class="w-full bg-rose-50 backdrop-blur-md p-5 rounded-2xl shadow-lg border border-rose-200 flex flex-col items-center text-center gap-3 hover:-translate-y-1 hover:bg-rose-100 transition-all active:scale-95">
            <div class="h-12 w-12 md:h-14 md:w-14 rounded-xl bg-rose-500 text-white flex items-center justify-center text-xl md:text-2xl shrink-0"><i class="fa-solid fa-power-off"></i></div>
            <div><h2 class="text-[13px] md:text-[14px] font-bold text-rose-700 leading-tight">Logout</h2><p class="text-[10px] md:text-[11px] text-rose-500 font-medium mt-1 leading-tight" id="current-user-display">User</p></div>
        </button>
    </div>
</div>

<div id="page-supplier" class="page w-full max-w-7xl mx-auto p-4 md:p-8">
    <div class="flex items-center mb-6 pt-2">
        <button onclick="goToApp('main')" class="mr-4 h-10 w-10 bg-white/90 backdrop-blur-md border border-white/20 rounded-full shadow-md flex items-center justify-center text-slate-800 hover:bg-white active:scale-90 transition"><i class="fa-solid fa-arrow-left"></i></button>
        <div>
            <h1 class="text-2xl font-black text-white drop-shadow-md tracking-tight">Supplier Debt</h1>
            <p class="text-[11px] font-bold text-fuchsia-300 uppercase tracking-widest drop-shadow-sm">Cost & Floating Status</p>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-white/95 backdrop-blur-xl p-6 rounded-2xl shadow-xl border border-white/20 flex flex-col items-center text-center">
            <div class="h-12 w-12 bg-rose-50 text-rose-600 rounded-full flex items-center justify-center text-xl mb-3"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Total Hutang (Unpaid)</p>
            <p id="sup-delivered" class="text-2xl md:text-3xl font-black text-rose-600 tracking-tight">RM0.00</p>
            <p class="text-[9px] text-slate-500 mt-2 font-medium">*Kos barang delivered yang BELUM dibayar</p>
        </div>
        <div class="bg-white/95 backdrop-blur-xl p-6 rounded-2xl shadow-xl border border-white/20 flex flex-col items-center text-center">
            <div class="h-12 w-12 bg-amber-50 text-amber-500 rounded-full flex items-center justify-center text-xl mb-3"><i class="fa-solid fa-spinner fa-spin-pulse"></i></div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Floating (In Transit)</p>
            <p id="sup-floating" class="text-2xl md:text-3xl font-black text-amber-600 tracking-tight">RM0.00</p>
            <p class="text-[9px] text-slate-500 mt-2 font-medium">*Pending / Dah Pos</p>
        </div>
        <div class="bg-white/95 backdrop-blur-xl p-6 rounded-2xl shadow-xl border border-white/20 flex flex-col items-center text-center">
            <div class="h-12 w-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center text-xl mb-3"><i class="fa-solid fa-box-open"></i></div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Cancel Debt (Return)</p>
            <p id="sup-return" class="text-2xl md:text-3xl font-black text-emerald-600 tracking-tight">RM0.00</p>
            <p class="text-[9px] text-slate-500 mt-2 font-medium">*Kos stok dipulangkan ke supplier</p>
        </div>
    </div>
    <div class="bg-slate-900/95 backdrop-blur-xl p-6 rounded-2xl shadow-2xl border border-slate-700 text-center flex flex-col items-center justify-center mt-8">
        <div class="h-16 w-16 bg-fuchsia-500/20 text-fuchsia-400 rounded-full flex items-center justify-center text-2xl mb-4 border border-fuchsia-500/30">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </div>
        <h2 class="text-lg font-black text-white mb-2">Manage Supplier Payments</h2>
        <p class="text-[11px] text-slate-400 mb-6 max-w-sm mx-auto">Klik butang di bawah untuk pergi ke sistem pengurusan hutang pembekal (External Link).</p>
        <button onclick="window.open('https://global.interactivelink.site/hutangsupplier', '_blank')" class="w-full md:w-auto md:px-12 bg-fuchsia-600 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-fuchsia-900/50 hover:bg-fuchsia-700 active:scale-95 transition flex items-center justify-center gap-2">
            OPEN SUPPLIER DEBT SYSTEM <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>
</div>

<div id="page-management" class="page w-full max-w-7xl mx-auto p-4 md:p-8">
    <div class="flex items-center mb-6 pt-2">
        <button onclick="goToApp('main')" class="mr-4 h-10 w-10 bg-white/90 backdrop-blur-md border border-white/20 rounded-full shadow-md flex items-center justify-center text-slate-800 hover:bg-white active:scale-90 transition"><i class="fa-solid fa-arrow-left"></i></button>
        <div><h1 class="text-2xl font-black text-white drop-shadow-md tracking-tight">Order Management</h1><p class="text-[11px] font-bold text-sky-300 uppercase tracking-widest drop-shadow-sm">Booking & Pending Tracker</p></div>
    </div>
    <div class="flex gap-2 mb-6 bg-white/10 p-1 rounded-xl backdrop-blur-md border border-white/20 max-w-md mx-auto md:mx-0">
        <button id="tab-btn-booking" onclick="switchMgmtTab('booking')" class="flex-1 py-2.5 text-sm font-bold rounded-lg bg-white text-sky-600 shadow-sm transition-all">Booking List</button>
        <button id="tab-btn-pending" onclick="switchMgmtTab('pending')" class="flex-1 py-2.5 text-sm font-bold rounded-lg text-white hover:bg-white/20 transition-all">Pending List</button>
    </div>
    <div id="mgmt-booking-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pb-8"></div>
    <div id="mgmt-pending-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pb-8 hidden"></div>
</div>

<div id="page-lead" class="page w-full max-w-7xl mx-auto p-4 md:p-8">
    <div class="flex items-center mb-6 pt-2">
        <button onclick="goToApp('main')" class="mr-4 h-10 w-10 bg-white/90 backdrop-blur-md border border-white/20 rounded-full shadow-md flex items-center justify-center text-slate-800 hover:bg-white active:scale-90 transition"><i class="fa-solid fa-arrow-left"></i></button>
        <div><h1 class="text-2xl font-black text-white drop-shadow-md tracking-tight">Lead Database</h1><p class="text-[11px] font-bold uppercase tracking-widest text-blue-300 drop-shadow-sm">Customer List</p></div>
    </div>
    <div class="bg-white/95 backdrop-blur-xl p-6 rounded-2xl shadow-xl border border-white/20 mb-6">
        <h2 class="text-[11px] font-bold mb-4 text-slate-400 uppercase tracking-widest border-b border-slate-100 pb-2">Add New Lead</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
            <input id="lead-name" type="text" placeholder="Customer Name" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-semibold text-slate-700 outline-none focus:border-blue-500 transition">
            <input id="lead-phone" type="tel" placeholder="Phone Number (E.g: 0123456789)" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-semibold text-slate-700 outline-none focus:border-blue-500 transition">
            <input id="lead-date" type="date" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-semibold text-slate-700 outline-none focus:border-blue-500 transition">
        </div>
        <button onclick="simpanLead()" class="w-full md:w-auto md:px-12 bg-blue-600 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-blue-200 hover:bg-blue-700 active:scale-95 transition float-right">SAVE LEAD</button>
        <div class="clear-both"></div>
    </div>
    <div class="flex justify-between items-center mb-3 ml-1">
        <h2 class="text-xs font-bold text-slate-300 uppercase tracking-widest drop-shadow-sm">Latest List</h2>
        <div class="flex items-center gap-2">
            <input id="filter-lead-date" type="date" onchange="renderLeadList()" class="bg-white/90 border border-white/20 rounded-lg p-1.5 text-[11px] font-bold outline-none text-slate-800 focus:border-blue-500 shadow-sm">
            <button onclick="clearLeadFilter()" class="h-7 w-7 bg-white/90 text-slate-600 rounded-lg flex items-center justify-center hover:bg-white transition active:scale-90"><i class="fa-solid fa-xmark text-[10px]"></i></button>
        </div>
    </div>
    <div id="lead-list-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></div>
</div>

<div id="page-accounting" class="page w-full max-w-7xl mx-auto p-4 md:p-8">
    <div class="flex items-center mb-6 pt-2">
        <button onclick="goToApp('main')" class="mr-4 h-10 w-10 bg-white/90 backdrop-blur-md border border-white/20 rounded-full shadow-md flex items-center justify-center text-slate-800 hover:bg-white active:scale-90 transition"><i class="fa-solid fa-arrow-left"></i></button>
        <div><h1 class="text-2xl font-black text-white drop-shadow-md tracking-tight">Accounting</h1><p class="text-[11px] font-bold text-purple-300 uppercase tracking-widest drop-shadow-sm">Financial Statements</p></div>
    </div>
    <div class="bg-white/95 backdrop-blur-xl p-8 rounded-2xl shadow-xl border border-white/20 flex flex-col items-center justify-center text-center min-h-[40vh]">
        <div class="h-24 w-24 bg-purple-50 text-purple-600 rounded-full flex items-center justify-center text-4xl mb-6 shadow-inner border border-purple-100">
            <i class="fa-solid fa-calculator"></i>
        </div>
        <h2 class="text-2xl font-black text-slate-800 mb-2">Generate Reports</h2>
        <p class="text-sm text-slate-500 mb-8 max-w-md mx-auto">Click the button below to view a dynamically calculated Balance Sheet based on your recorded transactions and assets.</p>
        <button onclick="bukaBalanceSheet()" class="w-full md:w-auto md:px-16 bg-purple-600 text-white font-bold py-4 rounded-xl shadow-lg shadow-purple-200 hover:bg-purple-700 active:scale-95 transition flex items-center justify-center gap-3 text-lg">
            <i class="fa-solid fa-scale-balanced"></i> BALANCE SHEET
        </button>
    </div>
</div>

