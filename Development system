// --- BANK LOGIC ---
function renderBank() {
    let balanceBank = 0; let allBankTxn = [];

    dbBank.forEach(txn => { allBankTxn.push({ id: txn.id, txnId: txn.txnId, date: txn.date, type: txn.type, amount: txn.amount, desc: txn.desc, source: 'manual' }); if(txn.type === 'masuk') balanceBank += txn.amount; else balanceBank -= txn.amount; });
    dbWallet.forEach(w => { if(w.type === 'topup') { allBankTxn.push({ id: w.id, txnId: w.txnId, date: w.date, type: 'keluar', amount: w.amount, desc: "Auto-Deduct (J&T Top-up)", source: 'jnt' }); balanceBank -= w.amount; } });

    dbKewangan.forEach(k => { 
        if(k.iklan > 0) { allBankTxn.push({ id: k.id, txnId: 'ADS' + k.date.replace(/-/g,'').slice(2), date: k.date, type: 'keluar', amount: k.iklan, desc: "Auto-Deduct (Ad Spend)", source: 'kewangan' }); balanceBank -= k.iklan; }

        let statusBayaran = k.costStatus || 'unpaid';
        let kosStokSebenar = k.costProduct ;
        
        if(kosStokSebenar > 0 && statusBayaran === 'paid') {
            allBankTxn.push({ id: k.id, txnId: 'STK' + k.date.replace(/-/g,'').slice(2), date: k.date, type: 'keluar', amount: kosStokSebenar, desc: "Auto-Deduct (Paid Capital/Stock)", source: 'kewangan' });
            balanceBank -= kosStokSebenar;
        }
    });

    dbOrder.forEach(o => { 
        if(o.status !== 'Return' && o.status !== 'Booking') { 
            if(o.delivery === 'Pos') { 
                allBankTxn.push({ id: o.id, txnId: o.txnId, date: o.date, type: 'masuk', amount: o.sell, desc: `Auto-Add POS Sale (${o.name})`, source: 'pos' }); 
                balanceBank += o.sell; 
            } else if(o.delivery === 'COD' && o.codStatus === 'Cleared') { 
                allBankTxn.push({ id: o.id, txnId: o.txnId, date: o.codClearedDate || o.date, type: 'masuk', amount: o.sell, desc: `Auto-Add COD Gross (${o.name})`, source: 'cod' }); 
                balanceBank += o.sell; 

                if(o.codFee > 0) {
                    allBankTxn.push({ id: o.id, txnId: o.txnId, date: o.codClearedDate || o.date, type: 'keluar', amount: o.codFee, desc: `Auto-Deduct J&T COD Fee (${o.name})`, source: 'cod' }); 
                    balanceBank -= o.codFee;
                }
            } 
        }
    });

    document.getElementById('bank-balance').innerText = `RM${getCensoredAmount(balanceBank, 'bank')}`;
    const container = document.getElementById('bank-list-container'); container.innerHTML = '';

    const filterDate = document.getElementById('filter-bank-date') ? document.getElementById('filter-bank-date').value : '';
    const filterSource = document.getElementById('filter-bank-source') ? document.getElementById('filter-bank-source').value : '';

    let filteredTxn = allBankTxn;
    if (filterDate) filteredTxn = filteredTxn.filter(t => t.date === filterDate);
    if (filterSource) {
        if (filterSource === 'masuk') filteredTxn = filteredTxn.filter(t => t.type === 'masuk');
        else if (filterSource === 'keluar') filteredTxn = filteredTxn.filter(t => t.type === 'keluar');
        else if (filterSource === 'manual') filteredTxn = filteredTxn.filter(t => t.source === 'manual');
        else if (filterSource === 'auto') filteredTxn = filteredTxn.filter(t => t.source !== 'auto');
    }

    if(filteredTxn.length === 0) {
        container.innerHTML = `<div class="text-center p-5 bg-white rounded-xl border border-slate-100 col-span-full"><p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">No records for this filter.</p></div>`;
        return;
    }

    filteredTxn.sort((a, b) => new Date(b.date) - new Date(a.date)).forEach(txn => {
        const isMasuk = txn.type === 'masuk'; const sign = isMasuk ? '+' : '-'; const color = isMasuk ? 'text-emerald-600' : 'text-slate-800'; const bgIcon = isMasuk ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-500'; const icon = isMasuk ? 'fa-arrow-turn-down' : 'fa-arrow-turn-up';

        const actionBtns = txn.source === 'manual' ? `
            <button onclick="bukaEditBank(${txn.id})" class="text-slate-400 hover:text-blue-500 p-1.5"><i class="fa-solid fa-pen text-sm"></i></button>
            <button onclick="padamBank(${txn.id})" class="text-slate-400 hover:text-rose-600 p-1.5"><i class="fa-solid fa-trash-can text-sm"></i></button>
        ` : `<span class="text-[10px] text-slate-400 italic pr-2">Auto</span>`;

        const txnBadge = txn.txnId ? `<span class="text-[9px] text-indigo-400 font-bold ml-1 font-mono">#${txn.txnId}</span>` : '';

        const card = `<div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex justify-between items-center"><div class="flex items-center gap-3"><div class="h-10 w-10 ${bgIcon} rounded-xl flex items-center justify-center font-bold"><i class="fa-solid ${icon}"></i></div><div><p class="text-[11px] font-bold text-slate-800">${txn.desc}</p><p class="text-[10px] text-slate-500 font-medium">${formatDisplayDate(txn.date)} ${txnBadge}</p></div></div><div class="flex items-center gap-2"><p class="text-sm font-black ${color}">${sign}RM${txn.amount.toFixed(2)}</p><div class="flex flex-col gap-1 border-l border-slate-100 pl-1 ml-1">${actionBtns}</div></div></div>`;
        container.innerHTML += card;
    });
}

