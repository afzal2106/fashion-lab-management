// --- ACCOUNTING / BALANCE SHEET LOGIC ---
function renderBalanceSheet() {
    let balanceBank = 0;
    dbBank.forEach(txn => { if(txn.type === 'masuk') balanceBank += txn.amount; else balanceBank -= txn.amount; });
    dbWallet.forEach(w => { if(w.type === 'topup') balanceBank -= w.amount; });

    dbKewangan.forEach(k => { 
        if(k.iklan > 0) balanceBank -= k.iklan;
        let kosStokSebenar = k.costProduct; 
        if(kosStokSebenar > 0 && k.costStatus === 'paid') balanceBank -= kosStokSebenar;
    });

    dbOrder.forEach(o => { 
        if(o.status !== 'Return' && o.status !== 'Booking') { 
            if(o.delivery === 'Pos') balanceBank += o.sell; 
            else if(o.delivery === 'COD' && o.codStatus === 'Cleared') {
                balanceBank += o.sell;
                if(o.codFee > 0) balanceBank -= o.codFee;
            }
        }
    });

    let balanceWallet = 0;
    dbWallet.forEach(txn => { if(txn.type === 'topup') balanceWallet += txn.amount; });
    dbKewangan.forEach(kew => { if(kew.shipping > 0) balanceWallet -= kew.shipping; });

    let pendingCod = 0;
    dbOrder.forEach(o => {
        if(o.delivery === 'COD' && o.codStatus !== 'Cleared' && o.status !== 'Return' && o.status !== 'Booking') {
            pendingCod += o.sell;
        }
    });

    let totalShippingLoss = 0;
    dbReturn.forEach(ret => totalShippingLoss += ret.cost); 
    dbKewangan.forEach(kew => { if(kew.return && kew.return > 0) totalShippingLoss += kew.return; });
    dbOrder.forEach(o => { 
        if (o.status === 'Return') {
            totalShippingLoss += getShippingPerOrder(o.date); 
        }
    });

    let totalAssets = balanceBank + balanceWallet + pendingCod;
    let accountsPayable = 0; 
    let equity = totalAssets - accountsPayable;

    const now = new Date();
    document.getElementById('bs-date').innerText = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    document.getElementById('bs-bank').innerText = `RM${balanceBank.toFixed(2)}`;
    document.getElementById('bs-wallet').innerText = `RM${balanceWallet.toFixed(2)}`;
    document.getElementById('bs-cod').innerText = `RM${pendingCod.toFixed(2)}`;
    document.getElementById('bs-inventory').innerText = `RM${totalShippingLoss.toFixed(2)}`;
    document.getElementById('bs-total-assets').innerText = `RM${totalAssets.toFixed(2)}`;
    document.getElementById('bs-payable').innerText = `RM${accountsPayable.toFixed(2)}`;
    document.getElementById('bs-equity').innerText = `RM${equity.toFixed(2)}`;
    document.getElementById('bs-total-liabilities').innerText = `RM${totalAssets.toFixed(2)}`;
}

