}

// --- DELETE MODAL DENGAN VERIFICATION ---
let currentDeleteAction = null;
let expectedDeleteCode = "";

function bukaDeleteModal(actionCallback) { 
    currentDeleteAction = actionCallback; 
    expectedDeleteCode = Math.floor(1000 + Math.random() * 9000).toString(); 
    document.getElementById('delete-code-display').innerText = expectedDeleteCode;
    const inputEl = document.getElementById('delete-code-input');
    inputEl.value = "";
    inputEl.classList.remove('border-rose-500', 'border-emerald-500', 'text-emerald-600');
    const btn = document.getElementById('confirm-delete-btn');
    btn.disabled = true;
    const modal = document.getElementById('delete-modal'); 
    const content = document.getElementById('delete-modal-content'); 
    modal.classList.remove('hidden'); 
    setTimeout(() => { content.classList.replace('scale-95', 'scale-100'); inputEl.focus(); }, 10); 
}

function checkDeleteCode() {
    const inputEl = document.getElementById('delete-code-input'); const btn = document.getElementById('confirm-delete-btn');
    if (inputEl.value === expectedDeleteCode) {
        btn.disabled = false; inputEl.classList.remove('border-rose-500'); inputEl.classList.add('border-emerald-500', 'text-emerald-600'); 
    } else {
        btn.disabled = true; inputEl.classList.remove('border-emerald-500', 'text-emerald-600');
        if(inputEl.value.length >= 4) inputEl.classList.add('border-rose-500'); else inputEl.classList.remove('border-rose-500');
    }
}

function tutupDeleteModal() { 
    const modal = document.getElementById('delete-modal'); const content = document.getElementById('delete-modal-content'); 
    content.classList.replace('scale-100', 'scale-95'); setTimeout(() => modal.classList.add('hidden'), 200); currentDeleteAction = null; 
}

document.getElementById('confirm-delete-btn').addEventListener('click', function() { 
    if (currentDeleteAction && document.getElementById('delete-code-input').value === expectedDeleteCode) { 
        currentDeleteAction(); tutupDeleteModal(); showToast("Record deleted successfully", "fa-check-circle"); 
    } 
});

// ==========================================
// --- ORDER MANAGEMENT LOGIC ---
// ==========================================
let currentMgmtTab = 'booking';
function switchMgmtTab(tab) {
    currentMgmtTab = tab;
    const btnBooking = document.getElementById('tab-btn-booking');
    const btnPending = document.getElementById('tab-btn-pending');
    const contBooking = document.getElementById('mgmt-booking-container');
    const contPending = document.getElementById('mgmt-pending-container');

    if(tab === 'booking') {
        btnBooking.className = "flex-1 py-2.5 text-sm font-bold rounded-lg bg-white text-sky-600 shadow-sm transition-all";
        btnPending.className = "flex-1 py-2.5 text-sm font-bold rounded-lg text-white hover:bg-white/20 transition-all";
        contBooking.classList.remove('hidden');
        contPending.classList.add('hidden');
    } else {
        btnPending.className = "flex-1 py-2.5 text-sm font-bold rounded-lg bg-white text-sky-600 shadow-sm transition-all";
        btnBooking.className = "flex-1 py-2.5 text-sm font-bold rounded-lg text-white hover:bg-white/20 transition-all";
        contPending.classList.remove('hidden');
        contBooking.classList.add('hidden');
    }
    renderOrderManagement();
}

function renderOrderManagement() {
    const contBooking = document.getElementById('mgmt-booking-container');
    const contPending = document.getElementById('mgmt-pending-container');
    contBooking.innerHTML = '';
    contPending.innerHTML = '';

    let bookings = dbOrder.filter(o => o.status === 'Booking');
    let pendings = dbOrder.filter(o => o.status === 'Pending');

    if (bookings.length === 0) {
         contBooking.innerHTML = `<div class="col-span-full text-center p-6 bg-white/90 rounded-2xl border border-white/20 shadow-sm"><p class="text-[11px] text-slate-500 font-bold uppercase tracking-widest">No booking orders found.</p></div>`;
    } else {
        bookings.sort((a,b) => new Date(a.bookingDate || a.date) - new Date(b.bookingDate || b.date)).forEach(order => {
            let countdownHtml = '';
            let reminderClass = "bg-slate-50 border-slate-200 text-slate-500";
            let icon = "fa-clock";

            if(order.bookingDate) {
                let today = new Date(); today.setHours(0,0,0,0);
                let bDate = new Date(order.bookingDate); bDate.setHours(0,0,0,0);
                let diffDays = Math.ceil((bDate - today) / (1000 * 60 * 60 * 24));

                if(diffDays > 0) {
                    countdownHtml = `${diffDays} Days Left`;
                    reminderClass = "bg-sky-50 border-sky-200 text-sky-600";
                    icon = "fa-calendar-day";
                }
                else if(diffDays === 0) {
                    countdownHtml = `Post Today!`;
                    reminderClass = "bg-amber-50 border-amber-200 text-amber-600";
                    icon = "fa-bell fa-shake";
                }
                else {
                    countdownHtml = `Overdue ${Math.abs(diffDays)} Days`;
                    reminderClass = "bg-rose-50 border-rose-200 text-rose-600";
                    icon = "fa-triangle-exclamation";
                }
            } else {
                countdownHtml = `No Date`;
            }

            const card = `<div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <p class="text-sm font-bold text-slate-800">${order.name}</p>
                            <p class="text-[10px] text-slate-400 font-bold">${order.phone}</p>
                        </div>
                        <span class="${reminderClass} border px-2 py-1 rounded-md text-[10px] font-black tracking-wide flex items-center gap-1.5 shadow-sm">
                            <i class="fa-solid ${icon}"></i> ${countdownHtml}
                        </span>
                    </div>
                    <p class="text-xs font-semibold text-slate-700 mt-2">${order.item}</p>
                    <p class="text-[10px] text-slate-500 mt-1 line-clamp-2"><i class="fa-solid fa-location-dot text-rose-400 mr-1"></i>${order.address || 'No Address'}</p>
                </div>
                <div class="flex justify-between items-center mt-4 pt-3 border-t border-slate-50">
                    <p class="text-xs font-black text-emerald-600">RM${order.sell.toFixed(2)}</p>
                    <button onclick="bukaEditOrder(${order.id})" class="text-[10px] bg-blue-50 text-blue-600 font-bold px-3 py-1.5 rounded-lg hover:bg-blue-100 transition active:scale-95 shadow-sm"><i class="fa-solid fa-pen mr-1"></i> Update Status</button>
                </div>
            </div>`;
            contBooking.innerHTML += card;
        });
    }

    if (pendings.length === 0) {
         contPending.innerHTML = `<div class="col-span-full text-center p-6 bg-white/90 rounded-2xl border border-white/20 shadow-sm"><p class="text-[11px] text-slate-500 font-bold uppercase tracking-widest">No pending orders found.</p></div>`;
    } else {
        pendings.sort((a,b) => new Date(b.date) - new Date(a.date)).forEach(order => {
            const card = `<div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <p class="text-sm font-bold text-slate-800">${order.name}</p>
                            <p class="text-[10px] text-slate-400 font-bold">${formatDisplayDate(order.date)} • ${order.phone}</p>
                        </div>
                        <span class="bg-amber-100 text-amber-700 border border-amber-200 px-2 py-0.5 rounded text-[9px] font-bold shadow-sm">Pending</span>
                    </div>
                    <p class="text-xs font-semibold text-slate-700 mt-2">${order.item}</p>
                    <p class="text-[10px] text-slate-500 mt-1 line-clamp-2"><i class="fa-solid fa-location-dot text-rose-400 mr-1"></i>${order.address || 'No Address'}</p>
                </div>
                <div class="flex justify-between items-center mt-4 pt-3 border-t border-slate-50">
                    <p class="text-xs font-black text-emerald-600">RM${order.sell.toFixed(2)}</p>
                    <button onclick="bukaEditOrder(${order.id})" class="text-[10px] bg-blue-50 text-blue-600 font-bold px-3 py-1.5 rounded-lg hover:bg-blue-100 transition active:scale-95 shadow-sm"><i class="fa-solid fa-pen mr-1"></i> Update Status</button>
                </div>
            </div>`;
            contPending.innerHTML += card;
        });
    }
}


// ==========================================
// --- ORDER FULL LOGIC (LIST, ADD, EDIT) ---
// ==========================================
function renderOrderList() {
    const container = document.getElementById('order-list-container');
    if (!container) return;
    container.innerHTML = '';

    const filterStatus = document.getElementById('filter-order-status')?.value || '';
    const filterDate = document.getElementById('filter-order-date')?.value || '';

    let filteredOrders = dbOrder;

    if (filterStatus) {
        if (filterStatus === 'COD' || filterStatus === 'Pos') {
            filteredOrders = filteredOrders.filter(o => o.delivery === filterStatus);
        } else {
            filteredOrders = filteredOrders.filter(o => o.status === filterStatus);
        }
    }
    
    if (filterDate) {
        filteredOrders = filteredOrders.filter(o => o.date === filterDate);
    }

    if (filteredOrders.length === 0) {
        container.innerHTML = `<div class="text-center p-5 bg-white/90 backdrop-blur-md rounded-xl border border-white/20 col-span-full"><p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">No order records found.</p></div>`;
        return;
    }

    filteredOrders.sort((a, b) => new Date(b.date) - new Date(a.date)).forEach(order => {
        let statusBadge = '';
        if (order.status === 'Pending') statusBadge = 'bg-amber-100 text-amber-700';
        else if (order.status === 'Dah Pos') statusBadge = 'bg-blue-100 text-blue-700';
        else if (order.status === 'Delivered') statusBadge = 'bg-emerald-100 text-emerald-700';
        else if (order.status === 'Return') statusBadge = 'bg-rose-100 text-rose-700';
        else if (order.status === 'Booking') statusBadge = 'bg-fuchsia-100 text-fuchsia-700';

        const card = `<div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 flex flex-col justify-between">
            <div>
                <div class="flex justify-between items-start mb-2">
                    <div>
                        <p class="text-sm font-bold text-slate-800">${order.name}</p>
                        <p class="text-[10px] text-slate-500 font-bold">${formatDisplayDate(order.date)} • ${order.phone}</p>
                    </div>
                    <span class="text-[9px] font-bold px-2 py-1 rounded-md ${statusBadge}">${order.status}</span>
                </div>
                <p class="text-xs font-semibold text-slate-700 mt-2 border-b border-slate-50 pb-2">${order.item}</p>
                <p class="text-[10px] text-slate-500 mt-2 line-clamp-2"><i class="fa-solid fa-location-dot text-rose-400 mr-1"></i>${order.address || 'No Address'}</p>
            </div>
            <div class="flex justify-between items-center mt-4 pt-3 border-t border-slate-50">
                <div>
                    <p class="text-xs font-black text-emerald-600">RM${order.sell.toFixed(2)}</p>
                    <p class="text-[9px] font-bold text-slate-400">${order.delivery} ${order.tracking ? '• ' + order.tracking : ''}</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="bukaEditOrder(${order.id})" class="h-8 w-8 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center hover:bg-blue-100 transition" title="Update Status"><i class="fa-solid fa-pen text-xs"></i></button>
                    <button onclick="bukaReturnModal(${order.id})" class="h-8 w-8 bg-rose-50 text-rose-600 rounded-lg flex items-center justify-center hover:bg-rose-100 transition" title="Mark as Return"><i class="fa-solid fa-truck-ramp-box text-xs"></i></button>
                    <button onclick="padamOrder(${order.id})" class="h-8 w-8 bg-slate-100 text-rose-500 rounded-lg flex items-center justify-center hover:bg-rose-200 transition" title="Delete Order"><i class="fa-solid fa-trash-can text-xs"></i></button>
                </div>
            </div>
        </div>`;
        container.innerHTML += card;
    });
}

function clearOrderFilter() {
    document.getElementById('filter-order-status').value = '';
    document.getElementById('filter-order-date').value = '';
    renderOrderList();
}

function simpanOrder() {
    const dateVal = document.getElementById('order-date').value || defaultDateVal;
    const name = document.getElementById('order-name').value;
    const phone = document.getElementById('order-phone').value;
    const item = document.getElementById('order-item').value;
    const address = document.getElementById('order-address').value;
    const delivery = document.getElementById('order-delivery').value;
    const status = document.getElementById('order-status').value;
    const bookingDate = document.getElementById('order-booking-date').value;
    const cost = parseFloat(document.getElementById('order-cost').value) || 0;
    const sell = parseFloat(document.getElementById('order-sell').value) || 0;
    const tracking = document.getElementById('order-tracking').value;

    if (!name || !item || sell <= 0) {
        showToast("Sila lengkapkan maklumat penting (Nama, Item, Harga)", "fa-circle-xmark");
        return;
    }

    const newId = dbOrder.length > 0 ? Math.max(...dbOrder.map(d => d.id)) + 1 : 1;
    
    dbOrder.push({
        id: newId, txnId: genTxnId('ORD'), date: dateVal, name: name, phone: phone, 
        item: item, address: address, delivery: delivery, status: status, 
        bookingDate: bookingDate, cost: cost, sell: sell, tracking: tracking,
        codStatus: status === 'Delivered' && delivery === 'COD' ? 'Pending' : '',
        codFee: 0
    });

    saveAllData();
    renderOrderList();
    
    document.getElementById('order-name').value = '';
    document.getElementById('order-phone').value = '';
    document.getElementById('order-item').value = '';
    document.getElementById('order-address').value = '';
    document.getElementById('order-cost').value = '';
    document.getElementById('order-sell').value = '';
    document.getElementById('order-tracking').value = '';
    document.getElementById('order-paste-area').value = '';
    
    showToast("Order berjaya disimpan!", "fa-check-circle");
}

function bukaEditOrder(id) {
    const order = dbOrder.find(o => o.id === id);
    if (!order) return;

    document.getElementById('edit-order-id').value = order.id;
    document.getElementById('edit-order-name').value = order.name;
