<script>
// --- HELPER FUNCTION: GENERATE TRANSACTION ID ---
function genTxnId(prefix) { return prefix + Math.floor(100000 + Math.random() * 900000); }

// --- HELPER FUNCTION: NORMALIZE PHONE NUMBER FOR DB CHECK ---
function normalizePhoneForCheck(p) {
    if (!p) return "";
    let num = p.toString().replace(/\D/g, '');
    if (num.startsWith('60')) num = '0' + num.substring(2);
    return num;
}

// --- HELPER UNTUK KIRA SHIPPING LOSS PER ORDER DARI FINANCE RECORD ---
function getShippingPerOrder(dateString) {
    const dailyRecord = dbKewangan.find(k => k.date === dateString);
    if (!dailyRecord || !dailyRecord.conversion || dailyRecord.conversion <= 0) return 5; 
    let shippingPerOrder = dailyRecord.shipping / dailyRecord.conversion;
    return shippingPerOrder > 0 ? shippingPerOrder : 5;
}

// --- REAL-TIME CLOCK & DATE ---
function updateClock() {
    const now = new Date();
    const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
    const dateOpts = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    const locale = 'en-US'; 
    const clockEl = document.getElementById('realtime-clock'); const dateEl = document.getElementById('realtime-date');
    if(clockEl) clockEl.innerText = now.toLocaleTimeString(locale, timeOpts); 
    if(dateEl) dateEl.innerText = now.toLocaleDateString(locale, dateOpts);
}
setInterval(updateClock, 1000);

// --- SUPPLIER DEBT LOGIC ---
function renderSupplierDebt() {
    let totalDelivered = 0; 
    let totalFloating = 0;
    let totalReturn = 0;

    dbOrder.forEach(o => {
        const kosSatuBarang = o.cost || 0;
        const kew = dbKewangan.find(k => k.date === o.date);
        const isPaid = kew && kew.costStatus === 'paid';

        if (o.status === 'Delivered') {
            if (!isPaid) {
                totalDelivered += kosSatuBarang;
            }
        } 
        else if (o.status === 'Return') {
            totalReturn += kosSatuBarang;
        } 
        else if (['Pending', 'Dah Pos'].includes(o.status)) {
            totalFloating += kosSatuBarang;
        }
    });

    document.getElementById('sup-delivered').innerText = `RM${totalDelivered.toFixed(2)}`;
    document.getElementById('sup-floating').innerText = `RM${totalFloating.toFixed(2)}`;
    document.getElementById('sup-return').innerText = `RM${totalReturn.toFixed(2)}`;
}

// --- LANGUAGE TOGGLE (Disabled/Hardcoded EN) ---
let currentLang = 'en';
function toggleLang() { 
    showToast("System language is locked to English", "fa-circle-info text-blue-500");
}
updateClock();

// --- TOAST NOTIFICATION ---
function showToast(message, icon = "fa-check-circle") {
    const container = document.getElementById('toast-container'); const toast = document.createElement('div'); let borderColor = "#4f46e5"; 
    if(icon.includes("check") || icon.includes("arrow-up")) borderColor = "#10b981"; if(icon.includes("xmark") || icon.includes("triangle")) borderColor = "#e11d48"; if(icon.includes("spinner") || icon.includes("cloud")) borderColor = "#8b5cf6"; 
    toast.className = 'toast-msg'; toast.style.borderLeftColor = borderColor; let finalIcon = icon.includes('text-') ? icon : `${icon} text-slate-800`;
    if (icon === "fa-check-circle" || icon === "fa-check") finalIcon = "fa-check-circle text-emerald-500"; if (icon === "fa-circle-xmark") finalIcon = "fa-circle-xmark text-rose-500";
    toast.innerHTML = `<i class="fa-solid ${finalIcon} text-xl"></i> <span class="flex-1">${message}</span>`; container.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateY(-20px) scale(0.9)'; toast.style.transition = 'all 0.3s ease'; setTimeout(() => toast.remove(), 300); }, 2500);
}

// --- VISIBILITY TOGGLE (STANDALONE) ---
const defaultVis = { bank: false, walletCod: false, walletPrepaid: false, orderCost: false, reportMonth: false, reportYear: false, reportSaleMonth: false, reportSaleYear: false };
let visibilityState = { ...defaultVis, ...(JSON.parse(localStorage.getItem('visibilityState')) || {}) };

function toggleVisibility(key) {
    visibilityState[key] = !visibilityState[key];
    localStorage.setItem('visibilityState', JSON.stringify(visibilityState));
    updateVisibilityIcon(key);

    if (key === 'bank' && document.getElementById('page-bank').classList.contains('active')) renderBank();
    if ((key === 'walletCod' || key === 'walletPrepaid') && document.getElementById('page-wallet').classList.contains('active')) renderWallet();
    if (key === 'orderCost' && document.getElementById('page-order').classList.contains('active')) renderOrderList();
    if ((key === 'reportMonth' || key === 'reportYear' || key === 'reportSaleMonth' || key === 'reportSaleYear') && document.getElementById('page-report').classList.contains('active')) renderReport();
}

function getCensoredAmount(amount, key) {
    return visibilityState[key] ? '****' : amount.toFixed(2);
}

function updateVisibilityIcon(key) {
    const icon = document.getElementById(`eye-icon-${key}`);
    if (icon) {
        if (visibilityState[key]) {
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
}

function initVisibility() {
    Object.keys(visibilityState).forEach(updateVisibilityIcon);
}
setTimeout(initVisibility, 100);

// --- TOGGLE FORMS (ACCORDION) ---
function toggleAddOrderForm() {
    const container = document.getElementById('add-order-form-container');
    const icon = document.getElementById('add-order-icon');
    if (container.classList.contains('hidden')) {
        container.classList.remove('hidden');
        icon.style.transform = 'rotate(180deg)';
    } else {
        container.classList.add('hidden');
        icon.style.transform = 'rotate(0deg)';
    }
}

function toggleKewanganForm() {
    const container = document.getElementById('kewangan-form-container');
    const icon = document.getElementById('kewangan-form-icon');
    if (container.classList.contains('hidden')) {
        container.classList.remove('hidden');
        icon.style.transform = 'rotate(180deg)';
    } else {
        container.classList.add('hidden');
        icon.style.transform = 'rotate(0deg)';
    }
}

// --- TOGGLE BOOKING DATE (ORDER DETAILS) ---
function toggleBookingDate(mode) {
    if (mode === 'add') {
        const status = document.getElementById('order-status').value;
        const container = document.getElementById('add-booking-container');
        if (status === 'Booking') { container.classList.remove('hidden'); }
