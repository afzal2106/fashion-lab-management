    if(existingLeadSameDate) { showToast("Lead already exists on this date.", "fa-circle-info text-blue-500"); return; } 
    const newId = dbLead.length > 0 ? Math.max(...dbLead.map(d => d.id)) + 1 : 1; 
    dbLead.push({ id: newId, name: name, phone: phone, date: dateLead }); 
    saveAllData(); document.getElementById('lead-name').value = ''; document.getElementById('lead-phone').value = ''; document.getElementById('lead-date').value = defaultDateVal; renderLeadList(); syncLeadCount(); if(document.getElementById('page-report').classList.contains('active')) renderReport(); 
}
function bukaEditLead(id) { const lead = dbLead.find(l => l.id === id); document.getElementById('edit-lead-id').value = lead.id; document.getElementById('edit-lead-name').value = lead.name; document.getElementById('edit-lead-phone').value = lead.phone; document.getElementById('edit-lead-date').value = lead.date; const modal = document.getElementById('edit-lead-modal'); const content = document.getElementById('modal-lead-content'); modal.classList.remove('hidden'); setTimeout(() => content.classList.replace('scale-95', 'scale-100'), 10); }
function tutupEditLead() { const modal = document.getElementById('edit-lead-modal'); const content = document.getElementById('modal-lead-content'); content.classList.replace('scale-100', 'scale-95'); setTimeout(() => modal.classList.add('hidden'), 200); }
function simpanEditLead() { const id = parseInt(document.getElementById('edit-lead-id').value); const index = dbLead.findIndex(l => l.id === id); dbLead[index].name = document.getElementById('edit-lead-name').value; dbLead[index].phone = document.getElementById('edit-lead-phone').value; dbLead[index].date = document.getElementById('edit-lead-date').value; saveAllData(); tutupEditLead(); renderLeadList(); syncLeadCount(); if(document.getElementById('page-report').classList.contains('active')) renderReport(); }

function padamLead(id) { 
    if (sesiUserSemasa && sesiUserSemasa.role === 'sales') {
        const lead = dbLead.find(l => l.id === id);
        if (lead) mohonPadam('Lead', id, `${lead.name} (${lead.phone})`);
        return;
    }
    bukaDeleteModal(() => { 
        dbLead = dbLead.filter(l => l.id !== id); 
        saveAllData(); renderLeadList(); syncLeadCount(); 
        if(document.getElementById('page-report').classList.contains('active')) renderReport(); 
    }); 
}

// --- KEWANGAN LOGIC ---
function calculateLive() { const ads = parseFloat(document.getElementById('ads').value) || 0; const lead = parseFloat(document.getElementById('kew-lead').value) || 0; const sale = parseFloat(document.getElementById('sale').value) || 0; document.getElementById('liveCpl').innerText = (ads > 0 && lead > 0) ? (ads / lead).toFixed(2) : "0.00"; document.getElementById('liveRoas').innerText = (sale > 0 && ads > 0) ? (sale / ads).toFixed(2) + 'x' : "0.00x"; }
function simpanRekodKewangan() { 
    const dateVal = document.getElementById('record-date').value; const newId = dbKewangan.length > 0 ? Math.max(...dbKewangan.map(d => d.id)) + 1 : 1; 
    dbKewangan.push({ id: newId, date: dateVal, iklan: parseFloat(document.getElementById('ads').value) || 0, lead: parseFloat(document.getElementById('kew-lead').value) || 0, conversion: parseFloat(document.getElementById('conversion').value) || 0, sale: parseFloat(document.getElementById('sale').value) || 0, shipping: 0, costProduct: 0, return: 0, codFee: 0 }); 
    saveAllData(); 
    document.getElementById('ads').value = ''; 
    document.getElementById('conversion').value = ''; 
    document.getElementById('sale').value = ''; 
    calculateLive(); 

    document.getElementById('kewangan-form-container').classList.add('hidden');
    document.getElementById('kewangan-form-icon').style.transform = 'rotate(0deg)';

    renderKewanganList();
    showToast("Record saved!", "fa-check-circle");
}
function renderKewanganList() { 
    const container = document.getElementById('kewangan-list-container'); container.innerHTML = ''; 

    const filterDate = document.getElementById('filter-kewangan-date')?.value;
    const searchQuery = (document.getElementById('search-kewangan')?.value || '').toLowerCase();

    let filteredList = dbKewangan;

    if (filterDate) {
        filteredList = filteredList.filter(k => k.date === filterDate);
    }

    if (searchQuery) {
        filteredList = filteredList.filter(k => {
            const displayDate = formatDisplayDate(k.date).toLowerCase();
            return displayDate.includes(searchQuery);
        });
    }

    if (filteredList.length === 0) {
        container.innerHTML = `<div class="text-center p-5 bg-white/90 backdrop-blur-md rounded-xl border border-white/20 col-span-full"><p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">No records found.</p></div>`;
        return;
    }

    filteredList.sort((a, b) => new Date(b.date) - new Date(a.date)).forEach(item => { 
        const netProfit = (item.sale - item.iklan - item.shipping - item.costProduct - (item.codFee || 0)).toFixed(2); 
        const card = `<div onclick="bukaDetailKewangan(${item.id})" class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 hover:border-indigo-300 transition-all flex items-center justify-between cursor-pointer active:scale-[0.99]"><div><p class="text-sm font-bold text-slate-800 mb-1"><i class="fa-regular fa-calendar text-indigo-500 mr-1"></i> ${formatDisplayDate(item.date)}</p><p class="text-[11px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 inline-block px-2 py-0.5 rounded-md">Net Profit: RM${netProfit}</p></div><div class="h-8 w-8 bg-slate-50 text-slate-400 rounded-full flex items-center justify-center"><i class="fa-solid fa-chevron-right text-xs"></i></div></div>`; 
        container.innerHTML += card; 
    }); 
}

function bukaDetailKewangan(id) { 
    const item = dbKewangan.find(d => d.id === id); const realTimeLead = dbLead.filter(l => l.date === item.date).length; const finalReturn = getAutoReturn(item.date); const codFee = item.codFee || 0; 
    const cpp = item.conversion > 0 ? (item.iklan / item.conversion).toFixed(2) : "0.00"; 
    const grossProfit = (item.sale - item.costProduct).toFixed(2); 
    const netProfit = (item.sale - item.iklan - item.shipping - item.costProduct - codFee).toFixed(2); 
    const roas = item.iklan > 0 ? (item.sale / item.iklan).toFixed(2) : "0.00"; 

    document.getElementById('detail-page-date').innerText = formatDisplayDate(item.date); 
    document.getElementById('det-net-profit').innerText = `RM${netProfit}`; 
    document.getElementById('det-sale').innerText = `RM${item.sale.toFixed(2)}`; 
    document.getElementById('det-ads').innerText = `RM${item.iklan.toFixed(2)}`; 
    document.getElementById('det-lead').innerText = realTimeLead; 
    document.getElementById('det-conversion').innerText = item.conversion; 
    document.getElementById('det-cpp').innerText = `RM${cpp}`; 
    document.getElementById('det-shipping').innerText = `-RM${item.shipping.toFixed(2)}`; 
    let costBadge = item.costStatus === 'paid' ? '<span class="bg-emerald-100 text-emerald-600 px-1 py-0.5 rounded ml-1 text-[8px]">PAID</span>' : '<span class="bg-rose-100 text-rose-600 px-1 py-0.5 rounded ml-1 text-[8px]">UNPAID</span>';
    document.getElementById('det-cost').innerHTML = `-RM${item.costProduct.toFixed(2)} ${costBadge}`; 
    document.getElementById('det-return').innerText = `RM${finalReturn.toFixed(2)}`; 
    document.getElementById('det-cod-fee').innerText = `-RM${codFee.toFixed(2)}`; 
    document.getElementById('det-gross').innerText = `RM${grossProfit}`; 
    document.getElementById('det-roas').innerText = `${roas}x`; 
    document.getElementById('det-edit-btn').setAttribute('onclick', `bukaEdit(${item.id})`); 
    document.getElementById('det-delete-btn').setAttribute('onclick', `padamRekodKewangan(${item.id})`); 

    document.querySelectorAll('.page').forEach(page => page.classList.remove('active')); 
    document.getElementById('page-kewangan-detail').classList.add('active'); 
    document.getElementById('bottom-nav').classList.add('hidden'); 
}

function padamRekodKewangan(id) { bukaDeleteModal(() => { dbKewangan = dbKewangan.filter(k => k.id !== id); saveAllData(); kembaliKeSenarai(); }); }

function bukaEdit(id) { 
    const data = dbKewangan.find(d => d.id === id); const realTimeLead = dbLead.filter(l => l.date === data.date).length; const autoRet = getAutoReturn(data.date);
    document.getElementById('edit-id').value = data.id; document.getElementById('edit-date-raw').value = data.date; document.getElementById('edit-date').innerText = formatDisplayDate(data.date); 
    document.getElementById('edit-ads').value = data.iklan; document.getElementById('edit-lead').value = realTimeLead; document.getElementById('edit-conversion').value = data.conversion; 
    document.getElementById('edit-sale').value = data.sale; document.getElementById('edit-shipping').value = data.shipping; document.getElementById('edit-cost').value = data.costProduct; 
    document.getElementById('edit-cost-status').value = data.costStatus || 'unpaid'; document.getElementById('edit-return').value = autoRet; document.getElementById('edit-cod-fee').value = data.codFee || 0; 
    const modal = document.getElementById('edit-modal'); const content = document.getElementById('modal-content'); 
    modal.classList.remove('hidden'); setTimeout(() => content.classList.replace('scale-95', 'scale-100'), 10); 
}

function tutupEdit() { const modal = document.getElementById('edit-modal'); const content = document.getElementById('modal-content'); content.classList.replace('scale-100', 'scale-95'); setTimeout(() => modal.classList.add('hidden'), 200); }

function simpanEdit() { 
    const id = parseInt(document.getElementById('edit-id').value); const index = dbKewangan.findIndex(d => d.id === id); 
    dbKewangan[index].iklan = parseFloat(document.getElementById('edit-ads').value) || 0; dbKewangan[index].conversion = parseFloat(document.getElementById('edit-conversion').value) || 0; 
    dbKewangan[index].sale = parseFloat(document.getElementById('edit-sale').value) || 0; dbKewangan[index].shipping = parseFloat(document.getElementById('edit-shipping').value) || 0; 
    dbKewangan[index].costProduct = parseFloat(document.getElementById('edit-cost').value) || 0; dbKewangan[index].costStatus = document.getElementById('edit-cost-status').value; 

    saveAllData(); tutupEdit(); bukaDetailKewangan(id); 
}

function renderReport() { 
    const selectMonth = parseInt(document.getElementById('filter-month').value); const selectYear = parseInt(document.getElementById('filter-year').value); 
    const monthNames = ["", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]; 
    document.getElementById('display-month-year').innerText = `${monthNames[selectMonth]} ${selectYear}`; 
    document.getElementById('display-year').innerText = `Year ${selectYear}`; 

    let totalSaleMonth = 0, totalAdsMonth = 0, totalNetMonth = 0, totalLeadMonth = 0; let totalSaleYear = 0, totalAdsYear = 0, totalNetYear = 0; 

    dbKewangan.forEach(item => { 
        const dateParts = item.date.split('T')[0].split('-'); const y = parseInt(dateParts[0]); const m = parseInt(dateParts[1]); 
        const net = item.sale - item.iklan - item.shipping - item.costProduct - (item.codFee || 0); 
        if (y === selectYear) { 
            totalSaleYear += item.sale; totalAdsYear += item.iklan; totalNetYear += net; 
            if (m === selectMonth) { totalSaleMonth += item.sale; totalAdsMonth += item.iklan; totalNetMonth += net; } 
        } 
    }); 

    dbLead.forEach(l => {
        if (!l.date) return;
        const dateParts = l.date.split('T')[0].split('-'); const y = parseInt(dateParts[0]); const m = parseInt(dateParts[1]); 
        if (y === selectYear && m === selectMonth) totalLeadMonth++;
    });

    document.getElementById('month-sale').innerText = `RM${getCensoredAmount(totalSaleMonth, 'reportSaleMonth')}`; document.getElementById('month-ads').innerText = `RM${totalAdsMonth.toFixed(2)}`; 
    document.getElementById('month-net').innerText = `RM${getCensoredAmount(totalNetMonth, 'reportMonth')}`; document.getElementById('month-lead').innerText = totalLeadMonth; 
    document.getElementById('month-cpl').innerText = `RM${(totalLeadMonth > 0 ? (totalAdsMonth / totalLeadMonth).toFixed(2) : "0.00")}`; 
    document.getElementById('month-roas').innerText = `${(totalAdsMonth > 0 ? (totalSaleMonth / totalAdsMonth).toFixed(2) : "0.00")}x`; 
    document.getElementById('year-sale').innerText = `RM${getCensoredAmount(totalSaleYear, 'reportSaleYear')}`; document.getElementById('year-net').innerText = `RM${getCensoredAmount(totalNetYear, 'reportYear')}`; 
    document.getElementById('year-roas').innerText = `${(totalAdsYear > 0 ? (totalSaleYear / totalAdsYear).toFixed(2) : "0.00")}x`; 
}

// --- WALLET JNT LOGIC ---
function renderWallet() { 
    let balance = 0; let allTxn = []; 
    dbWallet.forEach(txn => { if(txn.type === 'topup') { allTxn.push({ id: txn.id, txnId: txn.txnId, date: txn.date, type: 'topup', amount: txn.amount, desc: txn.desc }); balance += txn.amount; } }); 
    dbKewangan.forEach(kew => { if(kew.shipping > 0) { allTxn.push({ id: kew.id, txnId: 'KEW' + kew.date.replace(/-/g,'').slice(2), date: kew.date, type: 'usage', amount: kew.shipping, desc: "System Deduct (Daily Order Shipping)" }); balance -= kew.shipping; } }); 
    document.getElementById('wallet-balance').innerText = `RM${getCensoredAmount(balance, 'walletPrepaid')}`; 
    document.getElementById('wallet-estimate').innerText = `Balance enough for est. ${balance > 0 ? Math.floor(balance / 5) : 0} parcels (Est RM5/pc)`; 

    const container = document.getElementById('wallet-list-container'); container.innerHTML = ''; 
    allTxn.sort((a, b) => new Date(b.date) - new Date(a.date)).forEach(txn => { 
        const isTopup = txn.type === 'topup'; const sign = isTopup ? '+' : '-'; const color = isTopup ? 'text-emerald-600' : 'text-slate-800'; const bgIcon = isTopup ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-500'; const icon = isTopup ? 'fa-arrow-down' : 'fa-box'; 
        const txnBadge = txn.txnId ? `<span class="text-[9px] text-indigo-400 font-bold ml-1 font-mono">#${txn.txnId}</span>` : '';

        const card = `<div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex justify-between items-center"><div class="flex items-center gap-3"><div class="h-10 w-10 ${bgIcon} rounded-xl flex items-center justify-center font-bold"><i class="fa-solid ${icon}"></i></div><div><p class="text-[11px] font-bold text-slate-800">${txn.desc}</p><p class="text-[10px] text-slate-500 font-medium">${formatDisplayDate(txn.date)} ${txnBadge}</p></div></div><div class="flex items-center gap-3"><p class="text-sm font-black ${color}">${sign}RM${txn.amount.toFixed(2)}</p><div class="flex flex-col gap-1 border-l border-slate-100 pl-2 ml-1"><button onclick="bukaEditWallet('${txn.type}', ${txn.id})" class="text-slate-400 hover:text-blue-500 p-1"><i class="fa-solid fa-pen text-xs"></i></button><button onclick="padamWallet('${txn.type}', ${txn.id})" class="text-slate-400 hover:text-rose-500 p-1"><i class="fa-solid fa-trash text-xs"></i></button></div></div></div>`; 
        container.innerHTML += card; 
    });

    let pendingCodTotal = 0; const codContainer = document.getElementById('wallet-cod-list-container'); codContainer.innerHTML = '';
    let allPendingOrders = dbOrder.filter(o => o.delivery === 'COD' && o.codStatus !== 'Cleared' && o.status !== 'Return' && o.status !== 'Booking'); 

    allPendingOrders.forEach(o => pendingCodTotal += o.sell);
    document.getElementById('wallet-cod-pending').innerText = `RM${getCensoredAmount(pendingCodTotal, 'walletCod')}`;

    const searchQuery = (document.getElementById('search-wallet-cod')?.value || '').toLowerCase();
    let displayOrders = allPendingOrders;

    if (searchQuery) {
        displayOrders = displayOrders.filter(o => 
            (o.name && o.name.toLowerCase().includes(searchQuery)) || 
            (o.tracking && o.tracking.toLowerCase().includes(searchQuery))
        );
    }

    if (displayOrders.length === 0) {
        codContainer.innerHTML = `<div class="text-center p-4 bg-white rounded-xl border border-slate-100"><p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">No pending COD records found.</p></div>`;
    } else {
        displayOrders.sort((a, b) => new Date(b.date) - new Date(a.date)).forEach(order => {
            const txnBadge = order.txnId ? `<span class="text-[9px] text-indigo-500 ml-1 font-mono">#${order.txnId}</span>` : '';
            const trackingText = order.tracking || 'No Tracking';
            const card = `<div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex justify-between items-center">
                <div class="flex items-center gap-3"><div class="h-10 w-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center font-bold"><i class="fa-solid fa-truck-fast"></i></div><div><p class="text-[11px] font-bold text-slate-800">${order.name} ${txnBadge}</p><p class="text-[10px] text-slate-500 font-medium">${formatDisplayDate(order.date)} • ${trackingText}</p></div></div>
                <div class="flex items-center gap-3"><p class="text-sm font-black text-blue-600">RM${order.sell.toFixed(2)}</p><div class="border-l border-slate-100 pl-2 ml-1"><button onclick="clearCodPayment(${order.id})" class="bg-blue-600 text-white text-[10px] font-bold px-3 py-1.5 rounded-lg shadow-sm hover:bg-blue-700 active:scale-95 transition" title="Mark Money as Banked In">Bank In</button></div></div>
            </div>`;
            codContainer.innerHTML += card;
        });
    }
}

function simpanTopup() { const amount = parseFloat(document.getElementById('topup-amount').value); const dDate = document.getElementById('topup-date').value || defaultDateVal; if(!amount || amount <= 0) { showToast("Please enter top-up amount.", "fa-circle-xmark"); return; } const newId = dbWallet.length > 0 ? Math.max(...dbWallet.map(d => d.id || 0)) + 1 : 1; dbWallet.push({ id: newId, txnId: genTxnId('WLT'), type: "topup", amount: amount, date: dDate, desc: "Manual FPX Top-up" }); saveAllData(); document.getElementById('topup-amount').value = ''; document.getElementById('topup-date').value = defaultDateVal; renderWallet(); }
function bukaEditWallet(type, id) { 
    document.getElementById('edit-wallet-id').value = id; document.getElementById('edit-wallet-type').value = type; let amount = 0; let dateVal = ''; 
    if(type === 'topup') { const data = dbWallet.find(d => d.id === id); amount = data.amount; dateVal = data.date; } else { const data = dbKewangan.find(d => d.id === id); amount = data.shipping; dateVal = data.date; } 
    document.getElementById('edit-wallet-amount').value = amount; document.getElementById('edit-wallet-date').value = dateVal; 
    const modal = document.getElementById('edit-wallet-modal'); const content = document.getElementById('modal-wallet-content'); modal.classList.remove('hidden'); setTimeout(() => content.classList.replace('scale-95', 'scale-100'), 10); 
}
function tutupEditWallet() { const modal = document.getElementById('edit-wallet-modal'); const content = document.getElementById('modal-wallet-content'); content.classList.replace('scale-100', 'scale-95'); setTimeout(() => modal.classList.add('hidden'), 200); }
function simpanEditWallet() { 
    const id = parseInt(document.getElementById('edit-wallet-id').value); const type = document.getElementById('edit-wallet-type').value; const amt = parseFloat(document.getElementById('edit-wallet-amount').value) || 0; const newDate = document.getElementById('edit-wallet-date').value; 
    if(type === 'topup') { const index = dbWallet.findIndex(d => d.id === id); dbWallet[index].amount = amt; if(newDate) dbWallet[index].date = newDate; } else { const index = dbKewangan.findIndex(d => d.id === id); dbKewangan[index].shipping = amt; if(newDate) dbKewangan[index].date = newDate; } 
    saveAllData(); tutupEditWallet(); renderWallet(); if(document.getElementById('page-bank').classList.contains('active')) renderBank(); 
}
function padamWallet(type, id) { bukaDeleteModal(() => { if(type === 'topup') { dbWallet = dbWallet.filter(d => d.id !== id); } else { const index = dbKewangan.findIndex(d => d.id === id); dbKewangan[index].shipping = 0; } saveAllData(); renderWallet(); }); }
